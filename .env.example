# Puertos de los servicios
EVENTS_PORT=5001
BOOKING_PORT=5002

# Redis
REDIS_URL=redis://localhost:6379

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
BOOKINGS_TABLE=Bookings

# URL interna que usa booking-service para llamar a events-service
EVENTS_SERVICE_URL=http://localhost:5001

# OTel Collector (OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Grafana Cloud (opcional, ver docs/grafana-cloud.md) ---
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
